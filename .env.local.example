# ControlHub - Variáveis de Ambiente

# ==============================================================================
# SEGURANÇA: CHAVE DE CRIPTOGRAFIA AES-256-GCM
# ==============================================================================
ENCRYPTION_SECRET=controlhub_aes256_super_secret_key_prod_2026!

# ==============================================================================
# BANCO DE DADOS: TURSO CLOUD (LIBSQL SERVERLESS) OU SQLITE LOCAL
# ==============================================================================
# Para rodar localmente com SQLite (Padrão):
DATABASE_URL=file:controlhub.db

# Para conectar à nuvem Serverless do Turso Cloud (Produção / SaaS Multi-tenant):
# 1. Instale a CLI do Turso: npm install -g @turso/cli
# 2. Crie uma conta e um banco: turso auth signup -> turso db create controlhub-db
# 3. Pegue a URL e crie o token: turso db show controlhub-db -> turso db tokens create controlhub-db
# 4. Descomente as duas linhas abaixo:
# DATABASE_URL="libsql://controlhub-db-seuusuario.turso.io"
# DATABASE_AUTH_TOKEN="seu-token-jwt-do-turso"

# ==============================================================================
# OUTRAS CONFIGURAÇÕES
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
